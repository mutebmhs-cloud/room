# Copy to .env and replace every placeholder. Do not share or commit .env.
DOMAIN=writers.example.com
APP_SECRET=REPLACE_WITH_RANDOM_64_OR_MORE_CHARACTERS
DB_PASSWORD=REPLACE_WITH_STRONG_URL_SAFE_PASSWORD
# Optional. Leave empty to disable AI until privacy and billing are configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# v3: select one AI route; never enable more than one provider per request.
# openai (existing paid API when configured), groq (free-allowlist) or openrouter (:free only).
WRITER_AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_FREE_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODEL=
# Do not add credentials to Git, chat messages or client-side JavaScript.
